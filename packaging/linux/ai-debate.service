[Unit]
Description=AI Debate standalone service
Documentation=file://@PREFIX@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@DATA_DIR@
EnvironmentFile=-@CONF_DIR@/ai-debate.env
Environment=AI_DEBATE_HOME=@DATA_DIR@
Environment=NODE_ENV=production
ExecStart=@PREFIX@/bin/ai-debate serve
# 75 is the application's controlled-restart exit code. SuccessExitStatus keeps
# the service from being reported as failed, while RestartForceExitStatus makes
# on-failure restart it anyway. An explicit systemctl stop is still never restarted.
Restart=on-failure
SuccessExitStatus=75
RestartForceExitStatus=75
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
# ProtectSystem=strict makes the whole filesystem read-only; only application data
# is writable. EnvironmentFile is read by systemd (as root) before dropping privileges.
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

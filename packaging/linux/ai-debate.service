[Unit]
Description=AI Debate standalone service
Documentation=file://@PREFIX@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@DATA_DIR@
EnvironmentFile=-@CONF_DIR@/ai-debate.env
Environment=AI_DEBATE_HOME=@DATA_DIR@
Environment=NODE_ENV=production
ExecStart=@PREFIX@/bin/ai-debate serve
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
# 数据目录之外不应可写；这里只允许它写自己的状态与日志。
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@DATA_DIR@ @CONF_DIR@
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

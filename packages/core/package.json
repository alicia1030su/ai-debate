{
  "name": "@ai-debate/core",
  "version": "0.2.2",
  "private": true,
  "description": "AI Debate debate engine: thread analysis, stance reconstruction, persona drafting, safety gates, persistence.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./host": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./settings-routes": {
      "types": "./lib/settings-routes.d.ts",
      "default": "./lib/settings-routes.js"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "default": "./lib/config.js"
    },
    "./store": {
      "types": "./lib/store.d.ts",
      "default": "./lib/store.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-core.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

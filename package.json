{
  "name": "ai-debate",
  "version": "0.2.1",
  "private": true,
  "description": "AI Debate — standalone discussion analysis, persona-driven reply drafting and human-approved publishing workbench.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:core": "node scripts/build-core.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build:core && npm run build:web",
    "bundle": "node scripts/bundle-server.mjs",
    "package:windows": "node packaging/windows/build.mjs",
    "package:linux": "node packaging/linux/build.mjs",
    "test": "npm run test:core && npm run test:server && npm run test:web && npm run acceptance && npm run test:automation && npm run test:recovery && npm run test:paging && npm run test:upgrade",
    "test:core": "node --experimental-transform-types --test --test-concurrency=4 \"packages/core/test/**/*.test.ts\"",
    "start": "node --experimental-transform-types packages/server/src/cli.ts serve",
    "smoke": "node --experimental-transform-types test/acceptance/standalone.ts",
    "acceptance": "node --experimental-transform-types test/acceptance/standalone.ts",
    "test:server": "node --experimental-transform-types --test --test-concurrency=2 \"packages/server/test/**/*.test.ts\"",
    "test:web": "node --test packages/web/test/*.test.mjs",
    "pretest": "node scripts/build-core.mjs && node scripts/build-web.mjs && node scripts/bundle-server.mjs",
    "pretest:core": "node scripts/build-core.mjs",
    "pretest:server": "node scripts/build-core.mjs && node scripts/build-web.mjs && node scripts/bundle-server.mjs",
    "pretest:web": "node scripts/build-web.mjs",
    "preacceptance": "node scripts/build-core.mjs && node scripts/build-web.mjs && node scripts/bundle-server.mjs",
    "test:automation": "node --experimental-transform-types test/acceptance/automation.ts",
    "test:recovery": "node --experimental-transform-types test/acceptance/recovery.ts",
    "pretest:automation": "node scripts/build-core.mjs",
    "pretest:recovery": "node scripts/build-core.mjs && node scripts/bundle-server.mjs",
    "pretypecheck": "node scripts/build-core.mjs",
    "test:upgrade": "node --experimental-transform-types test/acceptance/upgrade.ts",
    "test:paging": "node --experimental-transform-types test/acceptance/paging.ts",
    "test:windows-launcher": "node --experimental-transform-types --test test/acceptance/windows-launcher.ts",
    "test:soak": "node --experimental-transform-types test/stress/soak.ts --seconds=120",
    "soak:v022": "node scripts/run-soak.mjs --seconds=86400 --monitors=1000 --seed=1 --kill-every=300",
    "presoak:v022": "node scripts/build-core.mjs",
    "test:soak:v022": "node --experimental-transform-types --test test/support/soak-faults.ts test/stress/soak-v022.ts",
    "pretest:soak:v022": "node scripts/build-core.mjs",
    "pretest:upgrade": "node scripts/build-core.mjs && node scripts/bundle-server.mjs",
    "pretest:paging": "node scripts/build-core.mjs",
    "pretest:windows-launcher": "node scripts/build-core.mjs && node scripts/build-web.mjs && node scripts/bundle-server.mjs",
    "pretest:soak": "node scripts/build-core.mjs"
  },
  "devDependencies": {
    "@types/node": "~22.10.2",
    "esbuild": "0.25.0",
    "jsdom": "25.0.1",
    "postject": "1.0.0-alpha.6",
    "typescript": "~5.7.2"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
